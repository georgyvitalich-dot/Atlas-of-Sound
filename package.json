{
  "name": "music-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "review": "node scripts/make-review.mjs",
    "validate:data": "node scripts/content.mjs",
    "content:report": "node scripts/content.mjs --report",
    "validate:selftest": "node scripts/content.mjs --selftest",
    "build:textures": "node --max-old-space-size=6144 scripts/build-textures.mjs",
    "deploy": "npm run build && cd dist && npx --yes vercel@latest link --yes --project atlas-of-sound && npx --yes vercel@latest deploy --prod --yes"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "d3-geo": "^3.1.1",
    "earcut": "^3.2.3",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
